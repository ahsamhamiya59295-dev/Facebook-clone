DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/facebook_clone?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
PORT=5000
HOST=0.0.0.0
CLIENT_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"
NODE_ENV="development"
MAX_UPLOAD_SIZE_MB=10
# In production set NODE_ENV=production and TRUST_PROXY=1 when behind a
# reverse proxy (nginx/caddy) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# ---- Production example (Netlify frontend + separate API host) ----
# NODE_ENV=production
# CLIENT_URL="https://fb-clone-2026.netlify.app"
# ALLOWED_ORIGINS="https://fb-clone-2026.netlify.app"
# TRUST_PROXY=1
#
# When the API host differs from the frontend host (cross-site), the auth and
# CSRF cookies are automatically emitted with SameSite=None; Secure in
# production so the browser sends them on cross-site XHR/WebSocket requests.